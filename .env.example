# Copy to .env and fill in.  The .env file is gitignored.
#
# NOT REQUIRED for Modules 1 and 2 — the data layer, RCA engine and query tools
# use no LLM at all. Without a key the agent still runs, using a deterministic
# rule-based classifier; only the prose quality degrades.
#
# No quotes. No spaces around '='. Nothing after the key.

# ── Provider ──────────────────────────────────────────────────────────
# groq | google | anthropic | openai | rule-based
# Blank or "auto" picks whichever key is present, in the order above.
LLM_PROVIDER=groq

# ── Groq (configured provider) ────────────────────────────────────────
# Free, no credit card: https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Defaults to config.GROQ_DEFAULT_MODEL (openai/gpt-oss-120b).
# check_llm.py lists what your account can actually reach.
# LLM_MODEL=openai/gpt-oss-120b
#
# The previous default, llama-3.3-70b-versatile, was deprecated 2026-06-17.
# It still answers for now, so this line is a one-variable revert if the
# replacement misbehaves:
# LLM_MODEL=llama-3.3-70b-versatile

# ── Alternatives ──────────────────────────────────────────────────────
# Google Gemini — https://aistudio.google.com/apikey
#   NOTE: accounts issued 'AQ.' prefix keys are affected by a known Google
#   restriction that provisions free-tier quota at ZERO. Every request returns
#   429 ... generate_content_free_tier_requests limit: 0
#   and creating new keys or projects does not fix it. This is why the build
#   moved to Groq.
# GOOGLE_API_KEY=

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
